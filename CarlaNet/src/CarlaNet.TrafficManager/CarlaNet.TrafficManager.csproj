<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CarlaNet.Types\CarlaNet.Types.csproj" />
    <ProjectReference Include="..\CarlaNet.Map\CarlaNet.Map.csproj" />
    <ProjectReference Include="..\CarlaNet.Transport\CarlaNet.Transport.csproj" />
    <!-- Wave 5 (Nav port): TM tick loop drives the walker AI when walkers
         are registered. The TM never proactively constructs a WalkerNavigation
         — it polls NavigationFactory.TryGet on each tick, so TMs running
         vehicle-only workloads never pay the navmesh-fetch cost. -->
    <ProjectReference Include="..\CarlaNet.Nav\CarlaNet.Nav.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The stages and the road-graph types they walk are internal; the tests exercise them
         directly rather than through the RPC surface, which would need a running server. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>CarlaNet.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.6" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
  </ItemGroup>

</Project>
