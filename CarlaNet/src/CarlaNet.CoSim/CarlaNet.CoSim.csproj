<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The TraCI client this bridge reads SUMO through, and the world package it reads the road
         network and the ground surface out of. Deliberately no reference to CarlaNet.Transport:
         everything here is computed from a SUMO frame, a world package and a catalogue, so it
         builds and is tested with no CARLA server anywhere. What the bridge needs from CARLA, the
         world tick, arrives as a delegate the session is given. -->
    <ProjectReference Include="..\CarlaNet.Sumo\CarlaNet.Sumo.csproj" />
    <ProjectReference Include="..\CarlaNet.Map\CarlaNet.Map.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CarlaNet.CoSim.Tests" />
  </ItemGroup>

</Project>
