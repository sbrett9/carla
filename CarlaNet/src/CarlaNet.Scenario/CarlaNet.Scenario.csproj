<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CarlaNet.Types\CarlaNet.Types.csproj" />
    <ProjectReference Include="..\CarlaNet.Transport\CarlaNet.Transport.csproj" />
    <ProjectReference Include="..\CarlaNet.Map\CarlaNet.Map.csproj" />
    <ProjectReference Include="..\CarlaNet.TrafficManager\CarlaNet.TrafficManager.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Executes ASAM OpenSCENARIO storyboards against a running world. Parsing, position resolution,
       trigger evaluation and command dispatch all happen in .NET, driven by the world tick: the Python
       client only starts and stops a scenario, and never participates in per-tick control, so scenario
       timing does not depend on interpreter scheduling or on round trips through the client. -->

</Project>
