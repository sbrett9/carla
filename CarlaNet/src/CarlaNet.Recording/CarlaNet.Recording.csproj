<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CarlaNet.Types\CarlaNet.Types.csproj" />
    <ProjectReference Include="..\CarlaNet.Transport\CarlaNet.Transport.csproj" />
    <ProjectReference Include="..\CarlaNet.Sensors\CarlaNet.Sensors.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Native capture-to-disk: encodes streamed camera frames to PNG and writes a CoT-XML telemetry
       sidecar, entirely in .NET (on the thread pool), so the Python client never touches the frame
       buffer or the GIL during recording. No third-party imaging dependency (PNG via ZLibStream). -->

</Project>
