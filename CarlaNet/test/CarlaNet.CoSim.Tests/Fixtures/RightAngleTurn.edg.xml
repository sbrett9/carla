<?xml version="1.0" encoding="UTF-8"?>
<!-- Input to netconvert for RightAngleTurn.net.xml; see RightAngleTurn.nod.xml for the command.
     Two lanes on the southern approach so a lane change has somewhere to go, and one on each of
     the three exits so a turn resolves to exactly one connection. -->
<edges xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/edges_file.xsd">
    <edge id="approach" from="south" to="centre" numLanes="2" speed="27.78"/>
    <edge id="ahead" from="centre" to="north" numLanes="1" speed="27.78"/>
    <edge id="turn_east" from="centre" to="east" numLanes="1" speed="27.78"/>
    <edge id="turn_west" from="centre" to="west" numLanes="1" speed="27.78"/>
</edges>
