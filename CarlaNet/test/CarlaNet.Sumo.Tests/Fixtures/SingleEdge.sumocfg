<?xml version="1.0" encoding="UTF-8"?>
<!-- An empty simulation: one 200 m edge and no vehicles at all. This is what the binding's
     end-to-end check runs, so that a failure is unambiguously the binding rather than anything
     about traffic. The step length matches the CARLA fixed delta the bridge ticks at. -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="SingleEdge.net.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <!-- Long enough that the simulation never ends underneath a stepping client; the client
             closes the connection when it is done. -->
        <end value="3600"/>
        <step-length value="0.05"/>
    </time>
    <report>
        <no-step-log value="true"/>
    </report>
</configuration>
