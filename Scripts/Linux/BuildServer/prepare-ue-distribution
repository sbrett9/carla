#!/bin/bash
#
# prepare-ue-distribution - Smart caching for Unreal Engine distributions
#
# Usage: prepare-ue-distribution <artifactory-path> <cache-dir>
#
# Example:
#   prepare-ue-distribution \
#     cat-local-generic-dev/unreal/UnrealEngine-5.7.4-carla-port-049f42955-Linux.tar.zst \
#     /home/catgithubrunner/ue-cache
#
# This script:
# 1. Downloads UE distribution from Artifactory (cached, with SHA verification)
# 2. Extracts it (cached, reuses existing extraction if SHA matches)
# 3. Outputs the path to the extracted UE distribution
#

set -euo pipefail

if [ $# -ne 2 ]; then
    echo "Usage: $0 <artifactory-path> <cache-dir>" >&2
    echo "Example: $0 cat-local-generic-dev/unreal/UE.tar.zst /home/user/ue-cache" >&2
    exit 1
fi

artifactory_path="$1"
cache_dir="$2"

# Read API key
credentials_file="/home/catgithubrunner/.artifactory/credentials"
if [ ! -f "$credentials_file" ]; then
    echo "ERROR: Credentials file not found: $credentials_file" >&2
    exit 1
fi
api_key=$(cat "$credentials_file" | tr -d '\n\r')

# Artifactory base URL
base_url="https://iasartifact.sncorp.com:8443/artifactory"

# Extract basename from path
basename=$(basename "$artifactory_path")
if [ -z "$basename" ]; then
    echo "ERROR: Could not determine basename from path: $artifactory_path" >&2
    exit 1
fi

# Set up cache directories
archives_dir="$cache_dir/archives"
checksums_dir="$cache_dir/checksums"
extracted_dir="$cache_dir/extracted"

mkdir -p "$archives_dir" "$checksums_dir" "$extracted_dir"

echo "=== Preparing UE Distribution ===" >&2
echo "Artifact: $basename" >&2
echo "Cache: $cache_dir" >&2
echo >&2

# Step 1: Download and verify SHA256 checksum from Artifactory
echo "[1/4] Checking remote checksum..." >&2
remote_sha256_url="${base_url}/${artifactory_path}.sha256"
remote_sha256_file="${checksums_dir}/${basename}.sha256.remote"

curl --fail --silent --show-error \
    -H "X-JFrog-Art-Api: ${api_key}" \
    -o "$remote_sha256_file" \
    "$remote_sha256_url"

# Parse the SHA from the checksum file (format: "SHA  filename")
remote_sha=$(awk '{print $1}' "$remote_sha256_file")
echo "Remote SHA256: $remote_sha" >&2

# Step 2: Check local archive cache
local_archive="${archives_dir}/${basename}"
local_sha256_file="${checksums_dir}/${basename}.sha256"
needs_download=false

if [ -f "$local_archive" ] && [ -f "$local_sha256_file" ]; then
    local_sha=$(awk '{print $1}' "$local_sha256_file")
    echo "Local SHA256:  $local_sha" >&2
    
    if [ "$local_sha" != "$remote_sha" ]; then
        echo "SHA mismatch - download required" >&2
        needs_download=true
    else
        echo "SHA match - using cached archive" >&2
    fi
else
    echo "Archive not cached - download required" >&2
    needs_download=true
fi

# Step 3: Download archive if needed
if [ "$needs_download" = true ]; then
    echo >&2
    echo "[2/4] Downloading archive from Artifactory..." >&2
    archive_url="${base_url}/${artifactory_path}"
    
    # Show progress if interactive terminal
    if [ -t 1 ]; then
        curl --fail --show-error --progress-bar \
            -H "X-JFrog-Art-Api: ${api_key}" \
            -o "$local_archive" \
            "$archive_url" | cat
    else
        curl --fail --show-error --silent \
            -H "X-JFrog-Art-Api: ${api_key}" \
            -o "$local_archive" \
            "$archive_url"
    fi
    
    # Save the checksum
    cp "$remote_sha256_file" "$local_sha256_file"
    echo "Download complete" >&2
else
    echo >&2
    echo "[2/4] Using cached archive (skipping download)" >&2
fi

# Step 4: Check if extraction exists
# Use a directory name based on the basename without extension and the SHA prefix
extraction_name="${basename%.tar.zst}-${remote_sha:0:8}"
extraction_path="${extracted_dir}/${extraction_name}"

if [ -d "$extraction_path" ]; then
    echo >&2
    echo "[3/4] Using cached extraction" >&2
    echo "Path: $extraction_path" >&2
else
    echo >&2
    echo "[3/4] Extracting archive (this may take several minutes)..." >&2
    echo "Target: $extraction_path" >&2
    
    # Create temp directory for extraction
    temp_extract="${extracted_dir}/.tmp-${extraction_name}-$$"
    mkdir -p "$temp_extract"
    
    # Extract with parallel zstd decompression (-T0 = use all cores)
    if command -v pv >/dev/null 2>&1; then
        pv "$local_archive" | tar -I "zstd -d -T0" -xf - -C "$temp_extract"
    else
        tar -I "zstd -d -T0" -xf "$local_archive" -C "$temp_extract"
    fi
    
    # Move to final location atomically
    mv "$temp_extract" "$extraction_path"
    echo "Extraction complete" >&2
fi

# Step 5: Output the path
ue_root="$extraction_path"
if [ ! -d "$ue_root/Engine" ]; then
    for candidate in "$extraction_path"/*; do
        if [ -d "$candidate/Engine" ]; then
            ue_root="$candidate"
            break
        fi
    done
fi

if [ ! -d "$ue_root/Engine" ]; then
    echo "ERROR: Could not locate Unreal Engine root under: $extraction_path" >&2
    exit 1
fi

echo >&2
echo "[4/4] UE distribution ready" >&2
echo "CARLA_UNREAL_ENGINE_PATH=$ue_root" >&2
echo >&2

# Output for consumption by CI scripts
echo "$ue_root"
