#!/usr/bin/env bash
#
# prepare-ue-distribution - download, verify and extract an Unreal Engine distribution.
#
# Usage: prepare-ue-distribution <artifactory-path> [cache-dir]
#
# Example:
#   UE_PATH=$(prepare-ue-distribution \
#       cat-local-generic-dev/unreal/UnrealEngine-5.7.4-carla-port-049f42955-Linux.tar.zst)
#
# Prints the engine root (the directory containing Engine/) on stdout; all progress goes
# to stderr so the caller can capture the path directly.
#
# CACHING:
#   <cache-dir>/archives/     downloaded .tar.zst archives
#   <cache-dir>/extracted/    extracted trees, one per archive checksum
#   <cache-dir>/.lock         advisory lock serialising mutation of the cache
#
#   An extraction is keyed on the archive's SHA256, so a rebuilt engine with the same
#   filename still produces a distinct cache entry. Each entry is marked complete only
#   after extraction succeeds, so an interrupted run is never mistaken for a usable cache.
#
# OPTIONS (after the positional arguments):
#   --keep <n>          extractions to retain, newest first (default: 2)
#   --force-download    ignore the cached archive
#   --force-extract     re-extract even if a complete extraction exists
#
# EXIT CODES:
#   0 success   1 general error   2 bad arguments   4 checksum verification failed
#   5 cache is locked by another process
#

set -euo pipefail

# The only return value is the engine root, which callers capture with $(...). Stdout is
# redirected to stderr for the whole script and the real stdout kept as file descriptor 3,
# so nothing a subcommand happens to print can be captured as part of the path.
exec 3>&1 1>&2

script_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=artifactory-common.sh
. "$script_dir/artifactory-common.sh"

if [ $# -lt 1 ]; then
    echo "Usage: $0 <artifactory-path> [cache-dir] [--keep n] [--force-download] [--force-extract]" >&2
    exit 2
fi

artifactory_path="$1"; shift
cache_dir="${UE_CACHE_DIR:-$HOME/ue-cache}"
if [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; then
    cache_dir="$1"; shift
fi

keep=2
force_download=0
force_extract=0
while [ $# -gt 0 ]; do
    case "$1" in
        --keep)           keep="$2"; shift ;;
        --keep=*)         keep="${1#*=}" ;;
        --force-download) force_download=1 ;;
        --force-extract)  force_extract=1 ;;
        *) echo "Unknown argument: $1" >&2; exit 2 ;;
    esac
    shift
done

log() { echo "$@" >&2; }

archive_name="$(basename "$artifactory_path")"
if [ -z "$archive_name" ]; then
    echo "ERROR: could not determine an archive name from: $artifactory_path" >&2
    exit 2
fi

archives_dir="$cache_dir/archives"
extracted_dir="$cache_dir/extracted"

# Adopt a cache from the earlier layout, before the build caches were gathered under one
# root, rather than re-downloading and re-extracting ~25 GB. Same filesystem, so a rename.
if [ ! -d "$archives_dir" ]; then
    for legacy in "$HOME/ue-cache" "/home/$(id -un)/ue-cache"; do
        if [ -d "$legacy/archives" ] && [ "$legacy" != "$cache_dir" ]; then
            echo "Adopting the Unreal Engine cache at $legacy as $cache_dir" >&2
            mkdir -p "$(dirname "$cache_dir")"
            rmdir "$cache_dir" 2>/dev/null || true
            mv "$legacy" "$cache_dir"
            break
        fi
    done
fi

mkdir -p "$archives_dir" "$extracted_dir"

# Written into an extraction only once it is complete and the engine root has been found.
EXTRACTION_MARKER=".extraction-complete"

exec 9>"$cache_dir/.lock"
if ! flock -w 300 9; then
    log "ERROR: another prepare-ue-distribution holds the cache lock ($cache_dir/.lock)"
    exit 5
fi

log "=== Preparing Unreal Engine distribution ==="
log "Artifact: $archive_name"
log "Cache:    $cache_dir"

# ── Expected checksum ───────────────────────────────────────────────────────
# The publisher stores a .sha256 sidecar next to each archive. It is the expected value
# only -- the archive itself is hashed locally below and compared against it.
log "[1/4] Fetching expected checksum ..."
expected_sha="$(art_curl "$(art_url "${artifactory_path}.sha256")" | awk 'NR==1{print $1}')"

if ! printf '%s' "$expected_sha" | grep -qE '^[0-9a-fA-F]{64}$'; then
    log "ERROR: no usable SHA256 sidecar at ${artifactory_path}.sha256"
    exit 4
fi
log "       expected: $expected_sha"

archive_path="$archives_dir/$archive_name"

# Hash of the cached archive, remembered so a multi-gigabyte file is not re-hashed on
# every build. The stamp is keyed on size and mtime; any change invalidates it.
stamp_path="$archive_path.sha256-stamp"
archive_fingerprint() {
    stat -c '%s:%Y' "$archive_path" 2>/dev/null || echo "missing"
}

cached_sha=""
if [ "$force_download" = "0" ] && [ -f "$archive_path" ] && [ -f "$stamp_path" ]; then
    stamp_fp="$(awk 'NR==1{print $1}' "$stamp_path")"
    if [ "$stamp_fp" = "$(archive_fingerprint)" ]; then
        cached_sha="$(awk 'NR==1{print $2}' "$stamp_path")"
    fi
fi

# ── Download ────────────────────────────────────────────────────────────────
if [ "$cached_sha" = "$expected_sha" ]; then
    log "[2/4] Cached archive matches the expected checksum; skipping download."
else
    if [ -n "$cached_sha" ]; then
        log "[2/4] Cached archive checksum differs from the remote; re-downloading."
    else
        log "[2/4] Downloading archive ..."
    fi

    # Download to a partial file and rename only after verification, so an interrupted
    # transfer can never be mistaken for a complete archive. --continue-at resumes an
    # earlier partial transfer instead of restarting a ~25 GB download from zero.
    partial="$archive_path.part"
    art_curl --continue-at - -o "$partial" "$(art_url "$artifactory_path")" \
        || art_curl -o "$partial" "$(art_url "$artifactory_path")"

    log "       verifying checksum ..."
    actual_sha="$(sha256sum "$partial" | awk '{print $1}')"
    if [ "$actual_sha" != "$expected_sha" ]; then
        log "ERROR: checksum mismatch for $archive_name"
        log "       expected: $expected_sha"
        log "       actual:   $actual_sha"
        rm -f "$partial"
        exit 4
    fi

    mv -f "$partial" "$archive_path"
    printf '%s %s\n' "$(archive_fingerprint)" "$expected_sha" > "$stamp_path"
    log "       download verified."
fi

# ── Extract ─────────────────────────────────────────────────────────────────
extraction_path="$extracted_dir/${archive_name%%.tar.*}-${expected_sha:0:12}"

find_engine_root() {
    # The archive may hold Engine/ at the top level or one directory down.
    local base="$1"
    if [ -d "$base/Engine" ]; then printf '%s' "$base"; return 0; fi
    local candidate
    for candidate in "$base"/*; do
        if [ -d "$candidate/Engine" ]; then printf '%s' "$candidate"; return 0; fi
    done
    return 1
}

if [ -f "$extraction_path/$EXTRACTION_MARKER" ] && [ "$force_extract" = "0" ]; then
    log "[3/4] Using cached extraction."
else
    log "[3/4] Extracting (this takes several minutes) ..."
    rm -rf "$extraction_path" "$extraction_path.tmp"
    mkdir -p "$extraction_path.tmp"

    tar -I 'zstd -d -T0' -xf "$archive_path" -C "$extraction_path.tmp"

    if ! find_engine_root "$extraction_path.tmp" >/dev/null; then
        log "ERROR: no Engine/ directory found in the extracted archive."
        rm -rf "$extraction_path.tmp"
        exit 1
    fi

    printf 'archive %s\nsha256 %s\n' "$archive_name" "$expected_sha" \
        > "$extraction_path.tmp/$EXTRACTION_MARKER"
    mv "$extraction_path.tmp" "$extraction_path"
    log "       extraction complete."
fi

ue_root="$(find_engine_root "$extraction_path")" || {
    log "ERROR: cached extraction is missing its Engine/ directory: $extraction_path"
    log "       Re-run with --force-extract to rebuild it."
    exit 1
}

# ── Prune ───────────────────────────────────────────────────────────────────
# Each engine costs ~25 GB compressed plus ~80 GB extracted, so unbounded caching fills
# the array. Keep the newest few and sweep interrupted extractions.
if [ "$keep" -gt 0 ]; then
    mapfile -t entries < <(find "$extracted_dir" -mindepth 1 -maxdepth 1 -type d ! -name '*.tmp' \
        -printf '%T@ %p\n' | sort -rn | awk '{print $2}')
    index=0
    for candidate in "${entries[@]}"; do
        index=$((index + 1))
        [ "$index" -le "$keep" ] && continue
        [ "$candidate" = "$extraction_path" ] && continue
        log "Pruning old extraction: $(basename "$candidate")"
        rm -rf "$candidate"
    done

    # Archives are pruned on the same policy but tracked separately: an archive is only
    # needed to rebuild its extraction, and the current one must always survive.
    mapfile -t archives < <(find "$archives_dir" -maxdepth 1 -type f ! -name '*.part' \
        ! -name '*.sha256-stamp' -printf '%T@ %p\n' | sort -rn | awk '{print $2}')
    index=0
    for candidate in "${archives[@]}"; do
        index=$((index + 1))
        [ "$index" -le "$keep" ] && continue
        [ "$candidate" = "$archive_path" ] && continue
        log "Pruning old archive: $(basename "$candidate")"
        rm -f "$candidate" "$candidate.sha256-stamp"
    done

    find "$extracted_dir" -mindepth 1 -maxdepth 1 -name '*.tmp' -type d -exec rm -rf {} + 2>/dev/null || true
    find "$archives_dir" -maxdepth 1 -name '*.part' -mtime +7 -delete 2>/dev/null || true
fi

log "[4/4] Unreal Engine ready at: $ue_root"

# The engine root is the script's return value and goes to the caller on descriptor 3;
# plain stdout is diagnostics (see the redirect at the top of this script).
printf '%s\n' "$ue_root" >&3
