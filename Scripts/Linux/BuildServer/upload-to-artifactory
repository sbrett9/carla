#!/usr/bin/env bash
#
# upload-to-artifactory - publish a build artifact to a generic Artifactory repository.
#
# Usage: upload-to-artifactory <local-file> <repo/target/path> [--no-checksum]
#
# Example:
#   upload-to-artifactory Build/Dist/Carla-0.10.0-Linux-Development-g1a2b3c4.tar.gz \
#       cat-local-generic-dev/carla/releases/Carla-0.10.0-Linux-Development-g1a2b3c4.tar.gz
#
# A .sha256 sidecar is uploaded alongside the artifact unless --no-checksum is given.
# The sidecar is what lets a consumer verify an download; prepare-ue-distribution relies
# on exactly this convention for the Unreal Engine archives.
#
# Credentials come from a mode-600 file on the runner host (see artifactory-common.sh),
# so no token ever reaches the workflow YAML, the command line or the logs.
#

set -euo pipefail

script_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=artifactory-common.sh
. "$script_dir/artifactory-common.sh"

if [ $# -lt 2 ]; then
    echo "Usage: $0 <local-file> <repo/target/path> [--no-checksum]" >&2
    exit 2
fi

local_file="$1"
target_path="$2"
shift 2

upload_checksum=1
while [ $# -gt 0 ]; do
    case "$1" in
        --no-checksum) upload_checksum=0 ;;
        *) echo "Unknown argument: $1" >&2; exit 2 ;;
    esac
    shift
done

if [ ! -f "$local_file" ]; then
    echo "ERROR: local file not found: $local_file" >&2
    exit 1
fi

target_url="$(art_url "$target_path")"

echo "Computing checksum ..."
sha256="$(sha256sum "$local_file" | awk '{print $1}')"

echo "Uploading: $local_file"
echo "Target:    $target_url"
echo "SHA256:    $sha256"

# Hand Artifactory the checksum so it verifies the transfer server-side and rejects a
# truncated upload instead of storing it.
art_curl -H "X-Checksum-Sha256: ${sha256}" -T "$local_file" "$target_url" >/dev/null

if [ "$upload_checksum" = "1" ]; then
    sidecar="$(mktemp)"
    trap 'rm -f "$sidecar"' EXIT
    printf '%s  %s\n' "$sha256" "$(basename "$local_file")" > "$sidecar"
    art_curl -T "$sidecar" "${target_url}.sha256" >/dev/null
    echo "Uploaded checksum sidecar: ${target_url}.sha256"
fi

echo "Verifying artifact ..."
if art_curl --head "$target_url" >/dev/null; then
    echo "Upload verified: $target_url"
else
    echo "ERROR: uploaded artifact is not retrievable at $target_url" >&2
    exit 1
fi
