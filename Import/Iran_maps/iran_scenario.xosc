    <Story name="MainStory">
      <Act name="DespawnAct">
        <ManeuverGroup maximumExecutionCount="1" name="DespawnGroup_Car_01">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Car_01"/>
          </Actors>
          <Maneuver name="Despawn_Car_01">
            <Event name="DespawnEvent_Car_01" priority="parallel" maximumExecutionCount="1">
              <Action name="DespawnAction_Car_01">
