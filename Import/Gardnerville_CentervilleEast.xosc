      <Act name="Despawn">
        <ManeuverGroup maximumExecutionCount="1" name="DespawnGroup_Car_Lead">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Car_Lead"/>
          </Actors>
          <Maneuver name="Despawn_Car_Lead">
            <Event name="DespawnEvent_Car_Lead" priority="parallel" maximumExecutionCount="1">
              <Action name="DespawnAction_Car_Lead">
                <GlobalAction>
                  <EntityAction entityRef="Car_Lead">
                    <DeleteEntityAction/>
                  </EntityAction>
                </GlobalAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="Arrived_Car_Lead" delay="0" conditionEdge="none">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="Car_Lead"/>
                      </TriggeringEntities>
                      <EntityCondition>
                        <ReachPositionCondition tolerance="8.0">
                          <Position>
                            <LanePosition roadId="276" laneId="-1" offset="0" s="82.0"/>
                          </Position>
                        </ReachPositionCondition>
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
