{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:carla-sumo-capture:schema:areas-resolved:1",
  "title": "Resolved areas of interest (areas.resolved.json in a .cwp)",
  "description": "The declared areas of interest placed on the built world: in CARLA meters, and on the SUMO lanes inside, crossing or near each one. Always written when the reference set is published; with no areas declared, the list is empty.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_file_name",
    "source_sha256",
    "world_map_name",
    "world_georeference",
    "world_origin_latitude",
    "world_origin_longitude",
    "network_fingerprint",
    "near_m",
    "frame",
    "areas"
  ],
  "properties": {
    "resolved_version": {
      "const": 1,
      "description": "The format of this file. A table without it is version 1."
    },
    "source_file_name": {
      "type": "string",
      "description": "The areas file's name. Empty when no areas were declared."
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$",
      "description": "SHA-256 of areas.aoi.geojson's bytes. Empty when no areas were declared. A reader refuses the table when this differs from the entry beside it."
    },
    "world_map_name": {
      "type": "string",
      "description": "MapName from world.json."
    },
    "world_georeference": {
      "type": "string",
      "description": "GeoReferenceString from world.json."
    },
    "world_origin_latitude": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "OriginLatitude from world.json, degrees."
    },
    "world_origin_longitude": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "OriginLongitude from world.json, degrees."
    },
    "network_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Fingerprint of the network the lanes are from."
    },
    "near_m": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "A lane within this distance, meters, of an area is near it."
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carla_from_sumo",
        "projected_by",
        "net_offset_m",
        "geodesy_agreement_limit_m",
        "geodesy_worst_residual_m"
      ],
      "properties": {
        "carla_from_sumo": {
          "type": "string",
          "minLength": 1,
          "description": "How a SUMO position becomes a CARLA one: carla(x, y) = sumo(x, -y)."
        },
        "projected_by": {
          "type": "string",
          "description": "What converted the areas' degrees to SUMO meters. Empty when no areas were declared."
        },
        "net_offset_m": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          },
          "description": "The network's netOffset, two numbers in meters. 0, 0 unless the roads were deliberately shifted."
        },
        "geodesy_agreement_limit_m": {
          "type": "number",
          "description": "How far apart, meters, SUMO's projection and the world's own may place one vertex before the table is refused."
        },
        "geodesy_worst_residual_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The largest such distance measured, meters. Null when no areas were declared."
        }
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "geographic",
          "carla_local",
          "envelope_carla_m",
          "sumo",
          "warnings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "description": "The area's id, as the areas file declares it."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The area's name."
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "description": "The area's kind, or null when the areas file gives none."
          },
          "geographic": {
            "type": "object",
            "description": "The area's GeoJSON geometry, copied from the areas file: [longitude, latitude] in WGS84 degrees. The areas file's schema is area_of_interest.schema.json.",
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "enum": [
                  "Polygon",
                  "MultiPolygon",
                  "Point"
                ]
              },
              "coordinates": {
                "type": "array"
              }
            }
          },
          "carla_local": {
            "description": "The area in CARLA meters, rounded to the millimeter.",
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "centre",
                  "radius_m"
                ],
                "properties": {
                  "type": {
                    "const": "Circle"
                  },
                  "centre": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "number"
                    },
                    "description": "A CARLA position: two numbers, x and y, meters."
                  },
                  "radius_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "const": "Polygon"
                  },
                  "coordinates": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "minItems": 4,
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "type": "number"
                        },
                        "description": "A CARLA position: two numbers, x and y, meters."
                      },
                      "description": "A closed ring of CARLA positions, first and last the same."
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "const": "MultiPolygon"
                  },
                  "coordinates": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "array",
                        "minItems": 4,
                        "items": {
                          "type": "array",
                          "minItems": 2,
                          "items": {
                            "type": "number"
                          },
                          "description": "A CARLA position: two numbers, x and y, meters."
                        },
                        "description": "A closed ring of CARLA positions, first and last the same."
                      }
                    }
                  }
                }
              }
            ]
          },
          "envelope_carla_m": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "number"
            },
            "description": "A rectangle in CARLA meters: four numbers, min x, min y, max x, max y. CARLA's frame has x east and y south."
          },
          "sumo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "edges",
              "lanes"
            ],
            "properties": {
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "edge_id",
                    "containment"
                  ],
                  "properties": {
                    "edge_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "containment": {
                      "enum": [
                        "inside",
                        "crossing",
                        "near"
                      ]
                    }
                  }
                },
                "description": "Each edge with a listed lane: inside when every lane is, crossing when any lane is inside or crossing, near otherwise."
              },
              "lanes": {
                "type": "array",
                "items": {
                  "description": "A lane inside, crossing, or near the area.",
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "lane_id",
                        "edge_id",
                        "containment",
                        "s_begin_m",
                        "s_end_m",
                        "intervals_m",
                        "allowed_vclasses"
                      ],
                      "properties": {
                        "lane_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "edge_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "containment": {
                          "enum": [
                            "inside",
                            "crossing"
                          ]
                        },
                        "s_begin_m": {
                          "type": "number",
                          "minimum": 0,
                          "description": "SUMO lane position, meters, where the first stretch inside begins."
                        },
                        "s_end_m": {
                          "type": "number",
                          "minimum": 0,
                          "description": "SUMO lane position, meters, where the last stretch inside ends."
                        },
                        "intervals_m": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "array",
                            "minItems": 2,
                            "items": {
                              "type": "number"
                            },
                            "description": "Begin and end, SUMO lane positions in meters."
                          },
                          "description": "Every stretch of the lane inside the area."
                        },
                        "allowed_vclasses": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "description": "SUMO vehicle classes allowed on the lane; all when the lane declares no restriction."
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "lane_id",
                        "edge_id",
                        "containment",
                        "distance_m",
                        "allowed_vclasses"
                      ],
                      "properties": {
                        "lane_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "edge_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "containment": {
                          "const": "near"
                        },
                        "distance_m": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Shortest distance, meters, from the lane to the area."
                        },
                        "allowed_vclasses": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "description": "SUMO vehicle classes allowed on the lane; all when the lane declares no restriction."
                        }
                      }
                    }
                  ]
                },
                "description": "Ordered by edge id, then lane id."
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What resolving the area warned about."
          }
        }
      },
      "description": "One entry per declared area, in the areas file's order."
    }
  }
}
