            },
            "on_warning": {
              "$ref": "#/$defs/resolved_field_with_default"
            },
            "expect": {
              "$ref": "#/$defs/resolved_field_with_default"
            },
            "capture.window": {
              "$ref": "#/$defs/resolved_field"
            },
            "capture.prewarm_s": {
              "$ref": "#/$defs/resolved_field_with_default"
            },
            "capture.world_delta_s": {
              "$ref": "#/$defs/resolved_field_with_default"
