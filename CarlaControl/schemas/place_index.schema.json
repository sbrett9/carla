{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:carla-sumo-capture:schema:place-index:1",
  "title": "Place index (places.json in a .cwp)",
  "description": "Which edges of the world's SUMO network carry which street name, and which way they head. Derived from map.net.xml alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "network_fingerprint",
    "coverage",
    "warnings",
    "streets"
  ],
  "properties": {
    "place_index_version": {
      "const": 1,
      "description": "The format of this file. An index without it is version 1."
    },
    "network_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Fingerprint of the network the index was made from."
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "description": "How much of the network the names cover.",
      "required": [
        "normal_edges",
        "named_edges",
        "named_fraction",
        "distinct_names",
        "names_by_script",
        "largest_name",
        "warn_below_named_fraction"
      ],
      "properties": {
        "normal_edges": {
          "type": "integer",
          "minimum": 0,
          "description": "Edges that are not inside a junction."
        },
        "named_edges": {
          "type": "integer",
          "minimum": 0,
          "description": "Of those, the edges with a street name."
        },
        "named_fraction": {
          "type": "number",
          "minimum": 0,
          "description": "named_edges / normal_edges, to four decimals."
        },
        "distinct_names": {
          "type": "integer",
          "minimum": 0,
          "description": "Different names."
        },
        "names_by_script": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Names per writing system. NONE counts names with no letters."
        },
        "largest_name": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "edge_count"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "edge_count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "The name carried by the most edges. Null when no edge is named."
        },
        "warn_below_named_fraction": {
          "type": "number",
          "description": "Below this named_fraction the index warns that names contribute little."
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What the index warned about when it was built."
    },
    "streets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "scripts",
          "edge_count",
          "length_m",
          "extent_carla_m",
          "directions",
          "edges"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The street name the edges carry."
          },
          "scripts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The writing systems of the name's letters, by Unicode name: LATIN, ARABIC and so on."
          },
          "edge_count": {
            "type": "integer",
            "minimum": 1,
            "description": "Edges carrying the name."
          },
          "length_m": {
            "type": "number",
            "description": "Their lengths added up, meters."
          },
          "extent_carla_m": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "number"
            },
            "description": "A rectangle in CARLA meters: four numbers, min x, min y, max x, max y. CARLA's frame has x east and y south."
          },
          "directions": {
            "type": "object",
            "additionalProperties": false,
            "description": "The edges heading each way, each list in the order a vehicle traveling that way meets them. A direction with no edge is left out.",
            "properties": {
              "north": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "east": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "south": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "west": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "edges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "edge_id",
                "from_junction",
                "to_junction",
                "bearing_deg",
                "direction",
                "length_m",
                "lane_count",
                "lane_ids",
                "speed_mps",
                "extent_carla_m"
              ],
              "properties": {
                "edge_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The SUMO edge id."
                },
                "from_junction": {
                  "type": "string",
                  "description": "The SUMO junction it leaves."
                },
                "to_junction": {
                  "type": "string",
                  "description": "The SUMO junction it reaches."
                },
                "bearing_deg": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Compass bearing, degrees clockwise from grid north, of the rightmost lane's first point to its last, from 0 up to but not including 360."
                },
                "direction": {
                  "enum": [
                    "north",
                    "east",
                    "south",
                    "west"
                  ],
                  "description": "The quarter of the compass the bearing falls in."
                },
                "length_m": {
                  "type": "number",
                  "description": "SUMO length of the rightmost lane, meters."
                },
                "lane_count": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Lanes on the edge."
                },
                "lane_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "The SUMO lane ids, rightmost first."
                },
                "speed_mps": {
                  "type": "number",
                  "description": "Speed limit of the rightmost lane, meters per second."
                },
                "extent_carla_m": {
                  "type": "array",
                  "minItems": 4,
                  "items": {
                    "type": "number"
                  },
                  "description": "A rectangle in CARLA meters: four numbers, min x, min y, max x, max y. CARLA's frame has x east and y south."
                }
              }
            },
            "description": "Every edge carrying the name, ordered by edge id."
          }
        }
      },
      "description": "One entry per street name, ordered by name."
    }
  }
}
