                "type": "integer",
                "description": "The CARLA generation the blueprint declares; -1 when none."
              },
              "declared_has_lights": {
                "type": "boolean",
                "description": "Whether the blueprint declares it has lights."
              },
              "settable_attributes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type",
                    "restrict_to_recommended",
                    "recommended_values"
                  ],
                  "properties": {
                    "id": {
